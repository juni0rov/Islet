    "behavior.wingsHint": {
      "comment": "Hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn everything off and the island hides behind the notch until you hover over it. Music and the timer still show up while they run."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если всё выключить, островок прячется за чёлкой, пока вы на него не наведёте. Музыка и таймер всё равно появляются, пока работают."
          }
        }
      }
    },
