    "display.note": {
      "comment": "Hint",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic prefers a screen with a camera notch, then the main screen. If the chosen display is disconnected, Islet switches back and restores it on reconnect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически выбирается экран с вырезом, затем основной. Если выбранный дисплей отключён, Islet вернётся к автовыбору и восстановит его при подключении."
          }
        }
      }
    },
    "display.status.floating": {
      "comment": "Status",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No notch: island floats as a capsule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выреза нет: островок — плавающая капсула."
          }
        }
      }
    },
    "display.status.hidden": {
      "comment": "Status",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough room: island is hidden, use the menu bar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мало места: островок скрыт, используйте меню."
          }
        }
      }
    },
    "display.status.notch": {
      "comment": "Status",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notch detected: island sits under the camera housing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вырез найден: островок под камерой."
          }
        }
